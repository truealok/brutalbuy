<div class="container page-body">
  <nav class="breadcrumb" style="margin-bottom:18px">
    <a href="{{ routes.account_url }}">{{ 'customer.account.title' | t }}</a> <span>›</span>
    <span style="color:var(--text)">{{ order.name }}</span>
  </nav>

  <h1 style="font-size:clamp(26px,3.4vw,36px);font-weight:900;margin-bottom:6px">{{ order.name }}</h1>
  <p style="color:var(--muted);margin-bottom:24px">Placed on {{ order.created_at | date: '%B %d, %Y' }}</p>

  <div style="display:grid;grid-template-columns:1.6fr .9fr;gap:30px;align-items:start" class="cart-cols">
    <div class="contact-card">
      {%- for line_item in order.line_items -%}
        <div class="cart-item" style="padding:18px 0">
          {%- if line_item.image -%}
            <img src="{{ line_item.image | image_url: width: 200 }}" style="width:92px;height:92px" alt="{{ line_item.title | escape }}" loading="lazy">
          {%- endif -%}
          <div style="flex:1">
            <div class="ci-name" style="font-size:15px">{{ line_item.title }}</div>
            <div style="font-size:12.5px;color:var(--muted)">
              {%- unless line_item.product.has_only_default_variant -%}{{ line_item.variant.title }} · {% endunless -%}
              Qty {{ line_item.quantity }}
            </div>
          </div>
          <div style="text-align:right;font-weight:900;color:var(--accent-strong)">
            {{ line_item.final_line_price | money }}
          </div>
        </div>
      {%- endfor -%}
    </div>

    <div class="contact-card">
      <h3 style="font-weight:900;margin-bottom:16px">Summary</h3>
      <div style="display:grid;gap:10px;font-size:14px;color:var(--text-dim)">
        <div style="display:flex;justify-content:space-between"><span>{{ 'customer.account.status' | t }}</span><b style="color:var(--text)">{{ order.financial_status_label }}</b></div>
        <div style="display:flex;justify-content:space-between"><span>Fulfillment</span><b style="color:var(--text)">{{ order.fulfillment_status_label }}</b></div>
        <div style="display:flex;justify-content:space-between"><span>{{ 'general.cart.subtotal' | t }}</span><b style="color:var(--text)">{{ order.subtotal_price | money }}</b></div>
        <div style="display:flex;justify-content:space-between"><span>Shipping</span><b style="color:var(--text)">{{ order.shipping_price | money }}</b></div>
        <div style="display:flex;justify-content:space-between"><span>Tax</span><b style="color:var(--text)">{{ order.tax_price | money }}</b></div>
      </div>
      <div style="border-top:1px solid var(--line);margin:16px 0;padding-top:16px;display:flex;justify-content:space-between;font-weight:900;font-size:18px">
        <span>{{ 'general.cart.total' | t }}</span>
        <span style="color:var(--accent-strong)">{{ order.total_price | money }}</span>
      </div>

      <h4 style="font-weight:900;margin:18px 0 8px">{{ 'customer.addresses.title' | t }}</h4>
      <div style="font-size:14px;color:var(--text-dim)">
        {{ order.shipping_address | format_address }}
      </div>
    </div>
  </div>
</div>
