<div class="container page-body">
  <div style="max-width:440px;margin-inline:auto">
    <div class="contact-card">
      <h1 style="font-weight:900;font-size:26px;margin-bottom:20px">{{ 'customer.register.title' | t }}</h1>

      {%- form 'create_customer' -%}
        {{ form.errors | default_errors }}

        <div class="form-grid">
          <div class="form-row">
            <div class="field"><input type="text" name="customer[first_name]" placeholder="{{ 'customer.register.first_name' | t }}" autocomplete="given-name"></div>
            <div class="field"><input type="text" name="customer[last_name]" placeholder="{{ 'customer.register.last_name' | t }}" autocomplete="family-name"></div>
          </div>
          <div class="field"><input type="email" name="customer[email]" placeholder="{{ 'customer.login.email' | t }}" autocomplete="email" required></div>
          <div class="field"><input type="password" name="customer[password]" placeholder="{{ 'customer.login.password' | t }}" autocomplete="new-password" required></div>
          <button class="btn btn-primary" style="width:100%">{{ 'customer.register.submit' | t }}</button>
        </div>
      {%- endform -%}

      <p style="margin-top:16px;font-size:13.5px">
        <a href="{{ routes.account_login_url }}" style="color:var(--accent-strong)">{{ 'customer.login.title' | t }} →</a>
      </p>
    </div>
  </div>
</div>
