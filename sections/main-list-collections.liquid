{%- comment -%} List of every collection you create in Shopify admin. {%- endcomment -%}
<div class="container page-body">
  <h1 style="font-size:clamp(28px,3.6vw,40px);font-weight:900;margin-bottom:22px">{{ section.settings.heading }}</h1>

  {%- paginate collections by 24 -%}
    <div class="brand-grid">
      {%- for collection in collections -%}
        <a class="brand-card reveal in" href="{{ collection.url }}">
          <div class="b-logo">{{ collection.title }}</div>
          <p>{{ collection.products_count }} products</p>
          <span class="section-link" style="margin-top:12px;display:inline-flex">Shop {{ collection.title }} →</span>
        </a>
      {%- endfor -%}
    </div>
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "All Collections" }
  ]
}
{% endschema %}
