{%- comment -%}
  Default page template. Any page you create in Shopify admin that isn't given
  one of the custom templates (about / contact / faqs / b2b / brands /
  withdrawal / account / catalog / product / cart) lands here.
{%- endcomment -%}
<section class="page-hero">
  <div class="container">
    <h1>{{ page.title }}</h1>
  </div>
</section>

<div class="container page-body">
  <div class="prose">{{ page.content }}</div>
</div>

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}
