{%- comment -%}
  Demo catalog page.

  Driven entirely by assets/bb-catalog.js against the generated catalog in
  bb-data.js, so the deep navigation (sport → cat → sub → brand → tag → sort →
  pagination) behaves exactly like the original static site.

  For the real Shopify collection listing see templates/collection.json.
{%- endcomment -%}
<div class="container">
  <nav class="breadcrumb" id="crumb" style="padding-top:22px"></nav>

  <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin:10px 0 6px">
    <h1 id="pageTitle" style="font-size:clamp(28px,3.6vw,40px);font-weight:900">{{ section.settings.heading }}</h1>
    <span class="results-count" id="resultsCount"></span>
  </div>

  <div class="sub-chips" id="subChips"></div>

  <div class="catalog-layout">
    <aside class="filters" id="filters"></aside>
    <div>
      <div class="catalog-top">
        <span class="results-count" id="resultsCount2" style="display:none"></span>
        <label style="display:flex;align-items:center;gap:10px;margin-left:auto;font-size:13.5px;color:var(--muted)">
          Sort by
          <select class="select" id="sortSel">
            <option value="featured">Featured</option>
            <option value="price-asc">Price: Low → High</option>
            <option value="price-desc">Price: High → Low</option>
            <option value="rating">Top Rated</option>
          </select>
        </label>
      </div>
      <div class="product-grid cols-3" id="catalogGrid"></div>
      <div class="pagination" id="pagination"></div>
    </div>
  </div>
</div>

<script src="{{ 'bb-catalog.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Catalog page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Fallback heading", "default": "All Sports Gear" }
  ]
}
{% endschema %}
