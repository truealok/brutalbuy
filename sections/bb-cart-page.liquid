{%- comment -%}
  Demo cart page — reads the localStorage cart written by assets/bb-main.js.
  Keeps the original line items, bulk discount and shipping logic.

  For the real Shopify cart see templates/cart.json.
{%- endcomment -%}
<div class="container page-body">
  <nav class="breadcrumb" style="margin-bottom:18px">
    <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a> <span>›</span> <span style="color:var(--text)">{{ 'general.cart.title' | t }}</span>
  </nav>
  <h1 style="font-size:clamp(28px,3.6vw,40px);font-weight:900;margin-bottom:24px">{{ 'general.cart.title' | t }}</h1>
  <div id="cartPage"></div>
</div>

<script src="{{ 'bb-cart.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Cart page (demo)",
  "settings": []
}
{% endschema %}
